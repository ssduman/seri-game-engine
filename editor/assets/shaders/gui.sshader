#beg_vs

#version 460 core

layout(location = 0) in vec2 in_position;
layout(location = 1) in vec2 in_uv;
layout(location = 2) in uvec4 in_color;

uniform mat4 u_projection;

out vec2 sent_uv;
out vec4 sent_color;

void main()
{
    sent_uv = in_uv;
    sent_color = vec4(in_color) / 255.0;
    gl_Position = u_projection * vec4(in_position, 0.0, 1.0);
}

#end_vs

#beg_fs

#version 460 core

in vec2 sent_uv;
in vec4 sent_color;

uniform sampler2D u_texture;

out vec4 final_color;

void main()
{
    final_color = sent_color * texture(u_texture, sent_uv);
}

#end_fs