#beg_vs

#version 460 core

layout(location = 0) in vec3 in_vertex;
layout(location = 1) in vec2 in_uv0;

uniform mat4 u_model;
uniform mat4 u_light_view_projection;

out vec2 sent_uv;

void main()
{
    sent_uv = in_uv0;
    gl_Position = u_light_view_projection * u_model * vec4(in_vertex, 1.0);
}

#end_vs

#beg_fs

#version 460 core

in vec2 sent_uv;

uniform sampler2D u_mask_texture;

void main()
{
    if (texture(u_mask_texture, sent_uv).r < 0.5)
    {
        discard;
    }
}

#end_fs