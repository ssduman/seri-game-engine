#beg_vs

#version 460 core

out vec2 sent_uv;

const vec2 k_verts[3] = vec2[](
    vec2(-1.0, -1.0),
    vec2( 3.0, -1.0),
    vec2(-1.0,  3.0)
);

void main()
{
    vec2 pos = k_verts[gl_VertexID];
    sent_uv = pos * 0.5 + 0.5;
    gl_Position = vec4(pos, 0.0, 1.0);
}

#end_vs

#beg_fs

#version 460 core

in vec2 sent_uv;

uniform sampler2D u_source_texture;
uniform vec2 u_texel_size;
uniform int u_fxaa_enabled;

out vec4 final_color;

const float FXAA_REDUCE_MIN = 1.0 / 128.0;
const float FXAA_REDUCE_MUL = 1.0 / 8.0;
const float FXAA_SPAN_MAX = 8.0;

float Luma(vec3 c)
{
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec3 Fxaa()
{
    vec3 rgbM = texture(u_source_texture, sent_uv).rgb;
    vec3 rgbNW = texture(u_source_texture, sent_uv + vec2(-1.0, -1.0) * u_texel_size).rgb;
    vec3 rgbNE = texture(u_source_texture, sent_uv + vec2( 1.0, -1.0) * u_texel_size).rgb;
    vec3 rgbSW = texture(u_source_texture, sent_uv + vec2(-1.0,  1.0) * u_texel_size).rgb;
    vec3 rgbSE = texture(u_source_texture, sent_uv + vec2( 1.0,  1.0) * u_texel_size).rgb;

    float lumaM = Luma(rgbM);
    float lumaNW = Luma(rgbNW);
    float lumaNE = Luma(rgbNE);
    float lumaSW = Luma(rgbSW);
    float lumaSE = Luma(rgbSE);

    float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
    float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));

    // no contrast around this pixel, so there is no edge to smooth
    if (lumaMax - lumaMin < max(0.03, lumaMax * 0.125))
    {
        return rgbM;
    }

    vec2 dir;
    dir.x = -((lumaNW + lumaNE) - (lumaSW + lumaSE));
    dir.y = +((lumaNW + lumaSW) - (lumaNE + lumaSE));

    float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) * (0.25 * FXAA_REDUCE_MUL), FXAA_REDUCE_MIN);
    float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
    dir = clamp(dir * rcpDirMin, vec2(-FXAA_SPAN_MAX), vec2(FXAA_SPAN_MAX)) * u_texel_size;

    vec3 rgbA = 0.5 * (
        texture(u_source_texture, sent_uv + dir * (1.0 / 3.0 - 0.5)).rgb +
        texture(u_source_texture, sent_uv + dir * (2.0 / 3.0 - 0.5)).rgb);
    vec3 rgbB = rgbA * 0.5 + 0.25 * (
        texture(u_source_texture, sent_uv + dir * -0.5).rgb +
        texture(u_source_texture, sent_uv + dir * 0.5).rgb);

    float lumaB = Luma(rgbB);

    return (lumaB < lumaMin || lumaB > lumaMax) ? rgbA : rgbB;
}

void main()
{
    if (u_fxaa_enabled == 1)
    {
        final_color = vec4(Fxaa(), 1.0);
    }
    else
    {
        final_color = texture(u_source_texture, sent_uv);
    }
}

#end_fs